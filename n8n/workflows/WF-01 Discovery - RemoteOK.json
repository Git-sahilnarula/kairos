{
  "name": "WF-01 Discovery - RemoteOK",
  "nodes": [
    {
      "parameters": {
        "url": "https://remoteok.com/api",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        -160
      ],
      "id": "ae7edf0d-d5a6-4ea2-9cbb-220cfbeb4059",
      "name": "Fetch RemoteOK"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst KEYWORDS = ['python','n8n','automation','sql','docker','ai','data','api','ollama'];\n\nconst normalized = [];\n\nfor (const item of items) {\n  const job = item.json;\n  if (!job.id) continue;\n\n  const skillsArray = Array.isArray(job.tags) ? job.tags : [];\n\n  // Safely check if any skill matches any keyword — never throws\n  let isRelevant = false;\n  for (const skill of skillsArray) {\n    const skillText = String(skill || \"\").toLowerCase();\n    if (KEYWORDS.some(keyword => skillText.includes(keyword))) {\n      isRelevant = true;\n      break;\n    }\n  }\n\n  normalized.push({\n    json: {\n      source: \"remoteok\",\n      source_opportunity_id: String(job.id || job.slug || \"\"),\n      title: job.position || \"Untitled\",\n      description: job.description || \"\",\n      url: job.url || \"\",\n      category: (job.tags && job.tags[0]) || null,\n      skills: skillsArray,\n      budget_min: job.salary_min || null,\n      budget_max: job.salary_max || null,\n      currency: \"USD\",\n      pricing_type: \"salary\",\n      posted_at: job.date || null,\n      deadline: null,\n      location: job.location || \"remote\",\n      experience_level: null,\n      client_name: job.company || null,\n      client_country: null,\n      client_rating: null,\n      client_hiring_history: null,\n      proposal_count: null,\n      metadata: {},\n      raw_data: job,\n      is_relevant: isRelevant\n    }\n  });\n}\n\nreturn normalized;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
