    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst KEYWORDS = ['python','n8n','automation','sql','docker','ai','data','api','ollama'];\n\nconst normalized = [];\n\nfor (const item of items) {\n  const job = item.json;\n  if (!job.title) continue;\n\n  const tagsArray = Array.isArray(job.tags) ? job.tags : [];\n\n  // Check if any tag matches keywords\n  let isRelevant = false;\n  for (const tag of tagsArray) {\n    const tagText = String(tag || \"\").toLowerCase();\n    if (KEYWORDS.some(keyword => tagText.includes(keyword))) {\n      isRelevant = true;\n      break;\n    }\n  }\n\n  // Also check title and company_name for keywords\n  if (!isRelevant) {\n    const titleText = String(job.title || \"\").toLowerCase();\n    const companyText = String(job.company_name || \"\").toLowerCase();\n    const combinedText = titleText + \" \" + companyText;\n    \n    for (const keyword of KEYWORDS) {\n      const pattern = new RegExp(`\\\\b${keyword}\\\\b`, 'i');\n      if (pattern.test(combinedText)) {\n        isRelevant = true;\n        break;\n      }\n    }\n  }\n\n  // Create source_opportunity_id from slug or title+company\n  let sourceId = job.slug || \"\";\n  if (!sourceId) {\n    sourceId = `${job.company_name}-${job.title}`.replace(/\\s+/g, '-').toLowerCase();\n  }\n\n  normalized.push({\n    json: {\n      source: \"arbeitnow\",\n      source_opportunity_id: String(sourceId),\n      title: job.title || \"Untitled\",\n      description: job.description || \"\",\n      url: job.url || \"\",\n      category: tagsArray.length > 0 ? tagsArray[0] : null,\n      skills: tagsArray,\n      budget_min: null,\n      budget_max: null,\n      currency: null,\n      pricing_type: null,\n      posted_at: job.date || null,\n      deadline: null,\n      location: job.location || \"\",\n      experience_level: null,\n      client_name: job.company_name || null,\n      client_country: null,\n      client_rating: null,\n      client_hiring_history: null,\n      proposal_count: null,\n      metadata: {\n        remote: job.remote\n      },\n      raw_data: job,\n      is_relevant: isRelevant\n    }\n  });\n}\n\nreturn normalized;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
