      "name": "Split Out"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst KEYWORDS = ['python','n8n','automation','sql','docker','ai','data','api','ollama'];\nconst PATTERNS = KEYWORDS.map(k => new RegExp(`\\\\b${k}\\\\b`, 'i'));\n\nconst normalized = [];\n\nfor (const item of items) {\n  const job = item.json;\n  if (!job.title) continue;\n\n  const tagsArray = Array.isArray(job.tags) ? job.tags : [];\n\n  // Relevant if a keyword appears as a whole word in any tag, the title, or the company name\n  const searchText = [\n    tagsArray.map(t => String(t || \"\")).join(\" \"),\n    String(job.title || \"\"),\n    String(job.company_name || \"\")\n  ].join(\" \");\n  const isRelevant = PATTERNS.some(p => p.test(searchText));\n\n  // Create source_opportunity_id from slug or title+company\n  let sourceId = job.slug || \"\";\n  if (!sourceId) {\n    sourceId = `${job.company_name}-${job.title}`.replace(/\\s+/g, '-').toLowerCase();\n  }\n\n  normalized.push({\n    json: {\n      source: \"arbeitnow\",\n      source_opportunity_id: String(sourceId),\n      title: job.title || \"Untitled\",\n      description: job.description || \"\",\n      url: job.url || \"\",\n      category: tagsArray.length > 0 ? tagsArray[0] : null,\n      skills: tagsArray,\n      budget_min: null,\n      budget_max: null,\n      currency: null,\n      pricing_type: null,\n      posted_at: job.date || null,\n      deadline: null,\n      location: job.location || \"\",\n      experience_level: null,\n      client_name: job.company_name || null,\n      client_country: null,\n      client_rating: null,\n      client_hiring_history: null,\n      proposal_count: null,\n      metadata: {\n        remote: job.remote\n      },\n      raw_data: job,\n      is_relevant: isRelevant\n    }\n  });\n}\n\nreturn normalized;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
