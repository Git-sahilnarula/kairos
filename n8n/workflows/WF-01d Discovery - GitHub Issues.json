    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst normalized = items.map(item => {\n  const issue = item.json.items;  // unwrap the nested \"items\" key\n\n  const labelNames = (issue.labels || []).map(l => l.name);\n\n  return {\n    json: {\n      source: \"github_issues\",\n      source_opportunity_id: String(issue.id || \"\"),\n      title: issue.title || \"Untitled\",\n      description: issue.body || \"\",\n      url: issue.html_url || \"\",\n      category: \"open-source bounty\",\n      skills: labelNames,\n      budget_min: null,\n      budget_max: null,\n      currency: null,\n      pricing_type: \"bounty\",\n      posted_at: issue.created_at || null,\n      deadline: null,\n      location: \"remote\",\n      experience_level: null,\n      client_name: issue.repository_url ? issue.repository_url.split(\"/\").slice(-2).join(\"/\") : null,\n      client_country: null,\n      client_rating: null,\n      client_hiring_history: null,\n      proposal_count: issue.comments || null,\n      metadata: {},\n      raw_data: issue,\n      is_relevant: true\n    }\n  };\n});\n\nreturn normalized;"
      },
