{
  "name": "WF-01b WeWorkRemotely",
  "nodes": [
    {
      "parameters": {
        "url": "https://weworkremotely.com/categories/remote-programming-jobs.rss",
        "options": {}
      },
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ],
      "id": "9d7062e5-9483-4d52-86bf-2a2a5ce5883e",
      "name": "RSS Read"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst KEYWORDS = ['python','n8n','automation','sql','docker','ai','data','api','ollama'];\n\nconst normalized = items.map(item => {\n  const job = item.json;\n\n  const searchText = `${job.title || \"\"} ${job.contentSnippet || job.content || \"\"}`.toLowerCase();\n  const isRelevant = KEYWORDS.some(keyword => {\n    const pattern = new RegExp(`\\\\b${keyword}\\\\b`, 'i');\n    return pattern.test(searchText);\n  });\n\n  return {\n    json: {\n      source: \"weworkremotely\",\n      source_opportunity_id: job.guid || job.link || \"\",\n      title: job.title || \"Untitled\",\n      description: job.contentSnippet || job.content || \"\",\n      url: job.link || \"\",\n      category: job.categories && job.categories[0] ? job.categories[0] : (job.category || null),\n      skills: [],\n      budget_min: null,\n      budget_max: null,\n      currency: null,\n      pricing_type: null,\n      posted_at: job.isoDate || job.pubDate || null,\n      deadline: null,\n      location: \"remote\",\n      experience_level: null,\n      client_name: null,\n      client_country: null,\n      client_rating: null,\n      client_hiring_history: null,\n      proposal_count: null,\n      metadata: {},\n      raw_data: job,\n      is_relevant: isRelevant\n    }\n  };\n});\n\nreturn normalized;"
      },
      "type": "n8n-nodes-base.code",
